<?xml version="1.0" encoding="UTF-8"?>
<!--
  ⚠️ Replace https://www.yourdomain.com below with your real production
  domain before launch, and update <lastmod> whenever content changes.
  This site is a single page (with anchor sections) plus five legal
  pages, so the sitemap lists the homepage and each standalone route —
  in-page anchors like #services are not separate crawlable URLs.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://www.yourdomain.com/</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://www.yourdomain.com/privacy-policy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://www.yourdomain.com/terms</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://www.yourdomain.com/cookie-policy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://www.yourdomain.com/refund-policy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://www.yourdomain.com/disclaimer</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
